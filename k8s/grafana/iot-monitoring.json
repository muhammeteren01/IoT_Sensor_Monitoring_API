        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT m.measurement_date AS time, s.name AS metric, m.temperature AS value\nFROM sensor_measurements m\nINNER JOIN sensors s ON s.id = m.sensor_id\nINNER JOIN zones z ON z.id = s.zone_id\nINNER JOIN facilities f ON f.id = z.facility_id\nINNER JOIN companies c ON c.id = f.company_id\nWHERE $__timeFilter(m.measurement_date)\n  AND m.temperature IS NOT NULL\n  AND c.name IN (${company:sqlstring})\n  AND s.name IN (${sensor:sqlstring})\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Anlık sıcaklık",
      "type": "stat"
